# Meta API Hub - Docker Compose environment variables
# Copy this file to .env and fill in your values
# cp docker/.env.example .env

# Required authentication tokens (change these!)
AUTH_TOKEN=change-me-admin-token
PROXY_TOKEN=change-me-proxy-sk-token

# Generate a unique 32+ byte random secret and do not reuse AUTH_TOKEN.
ACCOUNT_CREDENTIAL_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Scheduled tasks
CHECKIN_CRON=0 8 * * *
BALANCE_REFRESH_CRON=0 * * * *

# Deployment and notification defaults
PORT=4000
TZ=Asia/Shanghai
NOTIFY_COOLDOWN_SEC=300
ADMIN_IP_ALLOWLIST=
SYSTEM_PROXY_URL=

# OAuth client configuration. Gemini CLI and Antigravity require both values when used;
# Codex and Claude retain their provider-specific fallback semantics.
# Required only when using Gemini CLI OAuth.
GEMINI_CLI_CLIENT_ID=
GEMINI_CLI_CLIENT_SECRET=
# Required only when using Antigravity OAuth.
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
# Telegram notifications (TELEGRAM_API_BASE_URL defaults to https://api.telegram.org)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_USE_SYSTEM_PROXY=false
